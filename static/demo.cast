[0.002, "o", "\u001b[H\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\u001b[38;2;249;81;249m╭──────────────────────────────────────────────────────────────╮\u001b[0m\r\n\u001b[38;2;249;81;249m│\u001b[0m\u001b[37m┃ \u001b[0m\u001b[7mT\u001b[0m\u001b[38;5;240mype your message here. Enter to send, ESC to change mode\u001b[0m   \u001b[38;2;249;81;249m│\u001b[0m\r\n\u001b[38;2;249;81;249m│\u001b[0m\u001b[38;5;240m\u001b[37m┃ \u001b[0m\u001b[0m\u001b[30m \u001b[0m                                                           \u001b[38;2;249;81;249m│\u001b[0m\r\n\u001b[38;2;249;81;249m╰──────────────────────────────────────────────────────────────╯\u001b[0m\r\n\u001b[38;2;1;250;250m INSERT 🌴 \u001b[38;2;0;255;0mdev\u001b[0m             \u001b[38;2;1;250;250m🪣 3%\u001b[0m             \u001b[38;2;1;250;250mClaude-Opus-4-5\u001b[0m ✅ \u001b[0m\r\n\u001b[24;H\u001b[2K\r\u001b[?2004l\u001b[?25h\u001b[?1002l\u001b[?1003l\u001b[?1006l\u001b[?1049l\u001b[?25h"]
